# API key for the Assistant tab (querychat)
# Copy this file to .env and add at least one key

# OpenAI (default) - https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# GitHub PAT (alternative, free via model marketplace) - https://github.com/settings/tokens
# Use "models" scope. Sign up at https://github.com/marketplace/models
# GITHUB_TOKEN=your_github_pat_here

# Optional: override provider/model (e.g. QUERYCHAT_CLIENT=anthropic/claude-sonnet-4-5)
# Requires the corresponding API key
